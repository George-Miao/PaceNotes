DATABASE_URL=postgres://pacenotes:pacenotes-local@127.0.0.1:5432/pacenotes
# Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=replace-with-a-long-random-value
# Follow docs/deployment.md to create these Google values.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAP_ID=
# Optional HTTP JSON-RPC and MCP access. Keep disabled unless required.
# PACENOTES_EXTERNAL_ENABLED=true
# Use a server key restricted to Places API (New), separate from the browser key.
# GOOGLE_MAPS_SERVER_API_KEY=
# Exact browser origins for MCP and JSON-RPC WebSocket access.
# PACENOTES_EXTERNAL_ALLOWED_ORIGINS=https://trips.example.com
# Requests per minute. The web process uses these defaults when unset.
# PACENOTES_EXTERNAL_CLIENT_RPM=120
# PACENOTES_EXTERNAL_TRIP_RPM=240
# PACENOTES_EXTERNAL_SEARCH_CLIENT_RPM=30
# PACENOTES_EXTERNAL_SEARCH_TRIP_RPM=60
PORT=3000
# Optional hybrid routing for Japan public transport.
# MOTIS_URL=http://127.0.0.1:8080
# MOTIS_TIMEOUT_MS=5000
# Optional Frankfurter v2 exchange-rate endpoint for trip expenses.
# FRANKFURTER_URL=https://api.frankfurter.dev
