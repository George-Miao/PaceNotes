{
  "name": "pacenotes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm check:bundles && pnpm build:workers && pnpm typecheck",
    "build:workers": "esbuild src/db/migrate.ts --bundle --platform=node --format=esm --outfile=.output/migrate/index.mjs && esbuild src/launch.mjs --bundle --platform=node --format=esm --external:./server/index.mjs --outfile=.output/start.mjs",
    "check:bundles": "node scripts/check-bundle-size.mjs",
    "start": "node .output/start.mjs",
    "start:migrate": "node .output/migrate/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:performance": "lhci autorun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "2.1.1",
    "@googlemaps/markerclusterer": "2.6.2",
    "@hello-pangea/dnd": "18.0.1",
    "@hocuspocus/extension-database": "4.6.0",
    "@hocuspocus/provider": "4.6.0",
    "@hocuspocus/server": "4.6.0",
    "@iconify-icons/lucide": "2.0.2",
    "@iconify/react": "6.0.2",
    "@js-temporal/polyfill": "0.5.1",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "drizzle-orm": "0.45.2",
    "mdast-util-gfm-autolink-literal": "2.0.1",
    "mdast-util-gfm-strikethrough": "2.0.0",
    "mdast-util-gfm-task-list-item": "2.0.0",
    "micromark-extension-gfm-autolink-literal": "2.1.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-task-list-item": "2.1.0",
    "postgres": "3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "unified": "11.0.5",
    "workbox-window": "7.4.1",
    "yjs": "13.6.27",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.10",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@types/google.maps": "3.65.5",
    "@types/node": "24.10.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.0.1",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.27.7",
    "nitro": "3.0.260610-beta",
    "tsx": "4.21.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
